{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:block_state",
    "block_state_property": "type",
    "cases": [
      {
        "when": "vinyl",
        "model": {
          "type": "minecraft:model",
          "model": "hbm:item/sapling_vinyl"
        }
      },
      {
        "when": "pvc",
        "model": {
          "type": "minecraft:model",
          "model": "hbm:item/sapling_pvc"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "hbm:item/sapling_vinyl"
    }
  }
}
