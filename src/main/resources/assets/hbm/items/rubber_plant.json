{
  "model": {
    "type": "minecraft:select",
    "block_state_property": "type",
    "cases": [
      {
        "when": "grass",
        "model": {
          "type": "minecraft:model",
          "model": "hbm:item/rubber_plant_grass"
        }
      },
      {
        "when": "fern",
        "model": {
          "type": "minecraft:model",
          "model": "hbm:item/rubber_plant_fern"
        }
      },
      {
        "when": "shrub",
        "model": {
          "type": "minecraft:model",
          "model": "hbm:item/rubber_plant_shrub"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "hbm:item/rubber_plant_grass"
    }
  }
}
