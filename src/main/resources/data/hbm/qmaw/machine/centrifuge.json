    "zh_cn": "\u7528\u4e8e\u5206\u79bb\u7269\u54c1\uff0c\u53ef\u4f5c\u4e3a\u4e00\u79cd\u66f4\u9ad8\u6548\u7684\u77ff\u7269\u5904\u7406\u624b\u6bb5\u3002\u6700\u521d\u4e3b\u8981\u7528\u4e8e\u4ece\u7ea2\u77f3\u77ff\u77f3\u4e2d \u6536\u96c6\u5236\u4f5c[[Desh]]\u9700\u8981\u7684[[\u6c34\u94f6|Mercury]]\u3002"
